@using DataAccess.Entities
@{
    ViewData["Title"] = "Documents";
    var documents = ViewBag.Documents as List<Document>;
}
<h1>@ViewData["Title"]</h1>

<a class="btn btn-primary" asp-area="" asp-controller="Document" asp-action="Archive">Create</a>
<a  asp-controller="Document" asp-action="QrValidation" class="btn btn-info text-white">
    Validate QR
</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Doc Name</th>
            <th>Student Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doc in documents)
        {
            <tr>
                <td>@doc.DocumentName</td>
                <td>@doc.Student?.Name</td>
                <td>

                    <form asp-action="Delete" method="post">
                        <input class="d-none" name="Id" value="@doc.Id" />
                        <button class="btn btn-danger" type="submit">Delete</button>
                    </form>
                    <form asp-action="Print" method="post">
                        <input class="d-none" name="Id" value="@doc.Id" />
                        <button class="btn btn-primary" type="submit">Print</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>